    {
      "moduleRef": "a2.work",
      "lessonRef": "a2.work.001",
      "title": {
        "ru": "Планируем встречу",
        "en": "Scheduling a Meeting"
      },
      "description": {
        "ru": "Назначение времени и согласование слотов",
        "en": "Setting time and confirming slots"
      },
      "order": 1,
      "published": false,
      "estimatedMinutes": 12,
      "type": "conversation",
      "difficulty": "medium",
      "xpReward": 30,
      "hasAudio": true,
      "tasks": [
        {
          "ref": "a2.work.001.t1",
          "type": "choice",
          "data": {
            "question": "Как лучше предложить время встречи?",
            "options": [
              "When can we meet?",
              "Meet now.",
              "You must join.",
              "No meeting."
            ],
            "correctIndex": 0,
            "hint": "Нужна вежливая открытая формулировка",
            "explanation": "When can we meet? — нейтральный и вежливый вопрос о времени."
          }
        },
        {
          "ref": "a2.work.001.t2",
          "type": "gap",
          "data": {
            "text": "Let's ____ the meeting for Tuesday.",
            "answer": "schedule",
            "accept": ["schedule", "set"],
            "hint": "Глагол: назначить встречу",
            "explanation": "schedule/set the meeting — назначить встречу.",
            "caseInsensitive": true
          }
        },
        {
          "ref": "a2.work.001.t3",
          "type": "listen",
          "data": {
            "audioKey": "a2.work.001.t3.slot",
            "transcript": "I am available at 3 p.m.",
            "translation": "Я свободен в 15:00.",
            "question": "Во сколько человек свободен?",
            "options": ["2 p.m.", "3 p.m.", "4 p.m."],
            "correctIndex": 1,
            "hint": "Слушай число перед p.m.",
            "explanation": "В аудио звучит 3 p.m."
          }
        },
        {
          "ref": "a2.work.001.t4",
          "type": "order",
          "data": {
            "tokens": ["Does", "Thursday", "work", "for", "you", "?"]
          }
        },
        {
          "ref": "a2.work.001.t5",
          "type": "translate",
          "data": {
            "question": "Переведи: 'Перенесём встречу на завтра'",
            "expected": [
              "Let's move the meeting to tomorrow",
              "Let's reschedule the meeting to tomorrow"
            ],
            "hint": "Используй move/reschedule",
            "explanation": "Оба варианта корректны для переноса встречи."
          }
        },
        {
          "ref": "a2.work.001.t6",
          "type": "speak",
          "data": {
            "prompt": "Скажи: 'I can join at 10 a.m.'",
            "target": "I can join at 10 a.m.",
            "hint": "Ключ: join + время",
            "explanation": "Полная фраза для подтверждения времени участия."
          }
        }
      ]
    },
    {
