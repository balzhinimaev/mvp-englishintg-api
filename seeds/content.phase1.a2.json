            "correctIndex": 1,
            "hint": "Слушай количество days",
            "explanation": "В аудио: two more days."
          }
        },
        {
          "ref": "a2.work.002.t5",
          "type": "translate",
          "data": {
            "question": "Переведи: 'Задача почти завершена'",
            "expected": ["The task is almost done"],
            "hint": "almost + done",
            "explanation": "almost done — почти завершено."
          }
        },
        {
          "ref": "a2.work.002.t6",
          "type": "order",
          "data": {
            "tokens": ["I", "need", "help", "with", "this", "task"]
          }
        }
      ]
