            "correctIndex": 0,
            "hint": "Прямая и профессиональная формулировка",
            "explanation": "I have a blocker — стандартная фраза для статуса."
          }
        },
        {
          "ref": "a2.work.002.t3",
          "type": "gap",
          "data": {
            "text": "The task is ____ track.",
            "answer": "on",
            "accept": ["on"],
            "hint": "Фраза: on track",
            "explanation": "on track = по плану.",
            "caseInsensitive": true
          }
        },
        {
          "ref": "a2.work.002.t4",
          "type": "listen",
          "data": {
            "audioKey": "a2.work.002.t4.deadline",
            "transcript": "We need two more days.",
